# .env.example — copy to `.env` (git-ignored) and fill in real values
# before `docker compose up --build` for anything beyond a local demo.
# Every variable below has a working, obviously-insecure default baked
# into docker-compose.yml if you don't set it at all — that's deliberate
# (PB-11/PB-13): a deployment that "just works" with no secrets configured
# should look like one, not like a securely-configured one.

# Shared secret every business API endpoint requires via the X-API-Key
# header (see docs/LIMITATIONS.md). Default: CHANGE-ME-insecure-default-api-key
AEGIS_API_KEY=

# Postgres credentials used by the `postgres` service and read by
# api/dashboard/train-init to build DATABASE_URL — change all three
# together here, not in docker-compose.yml, so they can't drift apart.
# Defaults: aegis / aegis / aegis
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Optional full override — set this instead of the three POSTGRES_*
# vars above to point api/dashboard at something other than this
# compose file's own `postgres` service, e.g. a managed Postgres
# instance, or a SQLite file to skip Postgres entirely (D2 — Postgres is
# the reference datastore here, never a hard requirement of the DB
# access layer itself): sqlite:////srv/data/aegis.db
# DATABASE_URL=
